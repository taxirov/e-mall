# Local dev: run `npx prisma dev -d` and paste the connection string it prints.
# Production: use a Neon (or any Postgres) connection string.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/emall"

NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_ROOT_DOMAIN="e-mall.uz"

# realtime-server (see realtime-server/.env.example) — values must match
NEXT_PUBLIC_REALTIME_URL="http://localhost:4000"
REALTIME_JWT_SECRET="change-me"
REALTIME_API_KEY="change-me"

# Vercel Blob (product images / store logos) — filled in automatically once enabled on Vercel
BLOB_READ_WRITE_TOKEN=""
