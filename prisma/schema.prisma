// e-mall.uz — ko'p-do'konli marketplace + POS platformasi
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  OWNER
  SELLER
  CUSTOMER
}

enum StoreStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum PaymentMethod {
  CASH
  CARD
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum InventoryReason {
  SALE
  ORDER
  RESTOCK
  ADJUSTMENT
}

model User {
  id           String   @id @default(cuid())
  phone        String   @unique
  passwordHash String
  fullName     String
  role         Role
  storeId      String?
  store        Store?   @relation("StoreUsers", fields: [storeId], references: [id])
  ownedStore   Store?   @relation("StoreOwner")
  sales        Sale[]
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([storeId])
}

model Store {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  logoUrl     String?
  status      StoreStatus @default(PENDING)
  ownerId     String      @unique
  owner       User        @relation("StoreOwner", fields: [ownerId], references: [id])
  users       User[]      @relation("StoreUsers")
  categories  Category[]
  products    Product[]
  sales       Sale[]
  orders      Order[]
  inventoryLogs InventoryLog[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  products  Product[]
  createdAt DateTime  @default(now())

  @@index([storeId])
}

model Product {
  id            String         @id @default(cuid())
  storeId       String
  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      Category?      @relation(fields: [categoryId], references: [id])
  name          String
  sku           String?
  price         Decimal        @db.Decimal(12, 2)
  stock         Int            @default(0)
  images        String[]
  isPublished   Boolean        @default(false)
  saleItems     SaleItem[]
  orderItems    OrderItem[]
  inventoryLogs InventoryLog[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([storeId])
  @@index([storeId, isPublished])
}

model Sale {
  id            String        @id @default(cuid())
  storeId       String
  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sellerId      String
  seller        User          @relation(fields: [sellerId], references: [id])
  items         SaleItem[]
  total         Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  receiptNumber String        @unique
  createdAt     DateTime      @default(now())

  @@index([storeId])
  @@index([storeId, createdAt])
}

model SaleItem {
  id         String  @id @default(cuid())
  saleId     String
  sale       Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  qty        Int
  priceAtSale Decimal @db.Decimal(12, 2)

  @@index([saleId])
  @@index([productId])
}

model Order {
  id         String      @id @default(cuid())
  storeId    String
  store      Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId String
  customer   User        @relation(fields: [customerId], references: [id])
  items      OrderItem[]
  status     OrderStatus @default(PENDING)
  total      Decimal     @db.Decimal(12, 2)
  address    String?
  phone      String?
  note       String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([storeId])
  @@index([storeId, status])
  @@index([customerId])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  qty          Int
  priceAtOrder Decimal @db.Decimal(12, 2)

  @@index([orderId])
  @@index([productId])
}

model InventoryLog {
  id        String           @id @default(cuid())
  storeId   String
  store     Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId String
  product   Product          @relation(fields: [productId], references: [id])
  change    Int
  reason    InventoryReason
  createdAt DateTime         @default(now())

  @@index([storeId])
  @@index([productId])
}
