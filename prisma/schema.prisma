// e-mall.uz — ko'p-do'konli marketplace + POS platformasi
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  OWNER
  SELLER
  CUSTOMER
}

enum StoreStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum PaymentMethod {
  CASH
  CARD
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum InventoryReason {
  SALE
  ORDER
  RESTOCK
  ADJUSTMENT
}

enum EditRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TelegramVerificationType {
  REGISTER
  LOGIN
}

model User {
  id                   String               @id @default(cuid())
  phone                String               @unique
  passwordHash         String
  fullName             String
  role                 Role
  storeId              String?
  store                Store?               @relation("StoreUsers", fields: [storeId], references: [id])
  ownedStore           Store?               @relation("StoreOwner")
  /// Telegram chat id linked during REGISTER verification — used for
  /// Telegram-code login lookups. Never shown to the user themselves.
  telegramChatId       String?              @unique
  /// The phone number Telegram itself reported via contact-share, which can
  /// differ from `phone` (what the user typed on the site). Admin-only.
  telegramPhone        String?
  sales                Sale[]
  orders               Order[]
  stockReceipts        StockReceipt[]
  createdCatalogProducts CatalogProduct[]   @relation("CatalogProductCreatedBy")
  editRequests         ProductEditRequest[] @relation("EditRequestRequestedBy")
  reviewedEditRequests ProductEditRequest[] @relation("EditRequestReviewedBy")
  telegramVerifications TelegramVerification[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([storeId])
}

model Store {
  id                   String               @id @default(cuid())
  name                 String
  slug                 String               @unique
  description          String?
  logoUrl              String?
  status               StoreStatus          @default(PENDING)
  ownerId              String               @unique
  owner                User                 @relation("StoreOwner", fields: [ownerId], references: [id])
  users                User[]               @relation("StoreUsers")
  storeTypes           StoreType[]
  products             Product[]
  createdCatalogProducts CatalogProduct[]   @relation("CatalogProductCreatedByStore")
  editRequests         ProductEditRequest[]
  sales                Sale[]
  orders               Order[]
  inventoryLogs        InventoryLog[]
  stockReceipts        StockReceipt[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
}

/// A business category a store can operate as (e.g. "Oziq-ovqat",
/// "Kiyim-kechak") — Super-Admin-managed. A store can have several; each
/// Category belongs to exactly one, and a store only sees categories from
/// its own type(s) when adding products.
model StoreType {
  id         String     @id @default(cuid())
  name       String     @unique
  stores     Store[]
  categories Category[]
  createdAt  DateTime   @default(now())
}

/// Global category tree — managed only by Super Admin. Self-referencing
/// parentId gives a two-level category → sub-category hierarchy; stores
/// never create these, they only pick from what already exists.
model Category {
  id              String           @id @default(cuid())
  name            String
  imageUrl        String?
  storeTypeId     String
  storeType       StoreType        @relation(fields: [storeTypeId], references: [id])
  parentId        String?
  parent          Category?        @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children        Category[]       @relation("CategoryChildren")
  catalogProducts CatalogProduct[]
  createdAt       DateTime         @default(now())

  @@unique([parentId, name])
  @@index([parentId])
  @@index([storeTypeId])
}

/// A short-lived code issued by the Telegram bot (via webhook) and consumed
/// by the site to complete a registration or a passwordless login. Deleted
/// once consumed; a background sweep isn't needed at this scale since rows
/// are tiny and expiresAt makes stale ones harmless to leave around briefly.
model TelegramVerification {
  id             String                    @id @default(cuid())
  code           String                    @unique
  type           TelegramVerificationType
  telegramChatId String
  telegramPhone  String?
  userId         String?
  user           User?                     @relation(fields: [userId], references: [id])
  expiresAt      DateTime
  createdAt      DateTime                  @default(now())

  @@index([telegramChatId])
  @@index([expiresAt])
}

/// Shared/global product definition — created once (by whichever store adds
/// it first, or by Super Admin) and reused by every store afterward. Stores
/// can't create a duplicate of an existing catalog product; if it needs a
/// correction they submit a ProductEditRequest instead. Store-specific data
/// (price, stock, expiry, etc.) lives on Product, not here.
model CatalogProduct {
  id              String              @id @default(cuid())
  name            String
  categoryId      String
  category        Category            @relation(fields: [categoryId], references: [id])
  brand           String?
  unit            String
  size            String?
  barcode         String?
  description     String?
  imageUrl        String?
  createdByStoreId String?
  createdByStore  Store?              @relation("CatalogProductCreatedByStore", fields: [createdByStoreId], references: [id])
  createdById     String
  createdBy       User                @relation("CatalogProductCreatedBy", fields: [createdById], references: [id])
  products        Product[]
  editRequests    ProductEditRequest[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([categoryId])
  @@index([name])
  @@index([createdByStoreId])
}

/// A store's proposal to change a shared CatalogProduct it did not create.
/// `changes` only carries the fields being proposed (a sparse subset of
/// CatalogProduct's editable columns); Super Admin applies them on approval.
model ProductEditRequest {
  id               String             @id @default(cuid())
  catalogProductId String
  catalogProduct   CatalogProduct     @relation(fields: [catalogProductId], references: [id], onDelete: Cascade)
  storeId          String
  store            Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  requestedById    String
  requestedBy      User               @relation("EditRequestRequestedBy", fields: [requestedById], references: [id])
  changes          Json
  note             String?
  status           EditRequestStatus  @default(PENDING)
  reviewedById     String?
  reviewedBy       User?              @relation("EditRequestReviewedBy", fields: [reviewedById], references: [id])
  reviewNote       String?
  reviewedAt       DateTime?
  createdAt        DateTime           @default(now())

  @@index([catalogProductId])
  @@index([status])
  @@index([storeId])
}

model Product {
  id               String         @id @default(cuid())
  storeId          String
  store            Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  catalogProductId String
  catalogProduct   CatalogProduct @relation(fields: [catalogProductId], references: [id])
  sku              String?
  price            Decimal        @db.Decimal(12, 2)
  costPrice        Decimal?       @db.Decimal(12, 2)
  stock            Int            @default(0)
  lowStockThreshold Int?
  expiryDate       DateTime?
  isPublished      Boolean        @default(false)
  saleItems        SaleItem[]
  orderItems       OrderItem[]
  inventoryLogs    InventoryLog[]
  stockReceipts    StockReceipt[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([storeId])
  @@index([storeId, isPublished])
  @@index([catalogProductId])
  @@unique([storeId, catalogProductId])
}

/// A goods-receipt record — every time stock physically arrives at the
/// store. Keeps per-batch cost/selling price and expiry, and bumps
/// Product.stock + writes an InventoryLog(RESTOCK) entry when created.
model StockReceipt {
  id           String    @id @default(cuid())
  storeId      String
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId    String
  product      Product   @relation(fields: [productId], references: [id])
  quantity     Int
  costPrice    Decimal   @db.Decimal(12, 2)
  sellingPrice Decimal   @db.Decimal(12, 2)
  expiryDate   DateTime?
  supplier     String?
  receivedById String
  receivedBy   User      @relation(fields: [receivedById], references: [id])
  createdAt    DateTime  @default(now())

  @@index([storeId])
  @@index([productId])
  @@index([storeId, createdAt])
}

model Sale {
  id            String        @id @default(cuid())
  storeId       String
  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sellerId      String
  seller        User          @relation(fields: [sellerId], references: [id])
  items         SaleItem[]
  total         Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  receiptNumber String        @unique
  createdAt     DateTime      @default(now())

  @@index([storeId])
  @@index([storeId, createdAt])
}

model SaleItem {
  id          String  @id @default(cuid())
  saleId      String
  sale        Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  qty         Int
  priceAtSale Decimal @db.Decimal(12, 2)

  @@index([saleId])
  @@index([productId])
}

model Order {
  id         String      @id @default(cuid())
  storeId    String
  store      Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId String
  customer   User        @relation(fields: [customerId], references: [id])
  items      OrderItem[]
  status     OrderStatus @default(PENDING)
  total      Decimal     @db.Decimal(12, 2)
  address    String?
  phone      String?
  note       String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([storeId])
  @@index([storeId, status])
  @@index([customerId])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  qty          Int
  priceAtOrder Decimal @db.Decimal(12, 2)

  @@index([orderId])
  @@index([productId])
}

model InventoryLog {
  id        String          @id @default(cuid())
  storeId   String
  store     Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  change    Int
  reason    InventoryReason
  createdAt DateTime        @default(now())

  @@index([storeId])
  @@index([productId])
}
